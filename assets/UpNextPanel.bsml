                    horizontal-fit='Unconstrained' font-size='3.7'/>
            <text id='item0MetaText' text='' preferred-height='3' font-size='2.8' align='MidlineLeft'
                  overflow-mode='Ellipsis' word-wrapping='false'/>
            <text id='item0DifficultyText' text='' preferred-height='3.4' font-size='3' align='MidlineLeft'
