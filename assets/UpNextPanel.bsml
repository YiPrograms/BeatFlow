<vertical preferred-width='128' preferred-height='92' bg='round-rect-panel' pad='2' spacing='1'
          child-expand-height='false' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
          xsi:noNamespaceSchemaLocation='https://raw.githubusercontent.com/RedBrumbler/Quest-BSML-Docs/gh-pages/schema.xsd'>
  <text id='headingText' text='BeatNext' font-size='6' align='Center' preferred-height='7'/>
  <text id='statusText' text='Finding recommendations…' font-size='3.8' align='Center'
        preferred-height='6' word-wrapping='true'/>
  <horizontal preferred-height='73' child-expand-height='false' spacing='2'>
    <vertical preferred-width='82' preferred-height='73'>
