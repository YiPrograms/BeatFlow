    <vertical preferred-width='40' preferred-height='73' bg='round-rect-panel' pad='2' spacing='1'
              child-expand-height='false'>
      <text id='detailTitleText' text='Select a recommendation' font-size='4.4' align='Center'
            preferred-height='11' word-wrapping='true' overflow-mode='Ellipsis'/>
      <text id='detailArtistText' text='' font-size='3.5' color='#DDDDDD' align='Center'
            preferred-height='6' word-wrapping='true' overflow-mode='Ellipsis'/>
      <image id='detailImage' preferred-width='24' preferred-height='24' preserve-aspect='true'/>
      <text id='detailMetaText' text='' font-size='3.3' align='Center' preferred-height='6'
            word-wrapping='true' overflow-mode='Ellipsis'/>
      <text id='detailDifficultyText' text='' font-size='3.3' align='Center' preferred-height='7'
            word-wrapping='true' overflow-mode='Ellipsis'/>
      <primary-button id='actionButton' on-click='Action' text='Play' preferred-height='8' font-size='4'/>
    </vertical>
  </horizontal>
  <modal id='confirmModal' size-delta-x='80' size-delta-y='38'>
    <vertical pad='4' spacing='2'>
      <text text='Leave this song?' align='Center' font-size='5'/>
      <text text='Leave the current run and open this map in Solo?'
            align='Center' font-size='3.5' word-wrapping='true' preferred-height='10'/>
      <horizontal>
        <primary-button text='Leave and open' on-click='ConfirmExit'/>
        <button text='Stay here' on-click='CancelExit'/>
      </horizontal>
    </vertical>
  </modal>
</vertical>
