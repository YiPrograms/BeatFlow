<vertical id='background' bg='round-rect-panel' pad='1' pad-bottom='2'
          horizontal-fit='Unconstrained' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
          xsi:noNamespaceSchemaLocation='https://raw.githubusercontent.com/RedBrumbler/Quest-BSML-Docs/gh-pages/schema.xsd'>
  <horizontal spacing='3'>
    <text id='titleText' text='Song title' align='MidlineLeft' overflow-mode='Ellipsis'
          word-wrapping='false' rich-text='false'/>
    <text id='statusText' text='' align='MidlineRight' word-wrapping='false'/>
  </horizontal>
  <horizontal pad-top='1' pad-bottom='2' spacing='2'>
    <text id='artistText' text='Artist' align='MidlineLeft'
          overflow-mode='Ellipsis' word-wrapping='false' rich-text='false'/>
    <text id='mapperText' text='Mapper' align='MidlineRight'
          overflow-mode='Ellipsis' word-wrapping='false'/>
  </horizontal>
  <horizontal id='difficultiesContainer' bg='round-rect-panel' bg-color='#000000DD'>
    <text text='' align='Center' overflow-mode='Truncate'/>
    <text text='' align='Center' overflow-mode='Truncate'/>
    <text text='' align='Center' overflow-mode='Truncate'/>
    <text text='' align='Center' overflow-mode='Truncate'/>
    <text text='' align='Center' overflow-mode='Truncate'/>
  </horizontal>
</vertical>
